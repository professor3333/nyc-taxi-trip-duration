# Copy to .env (git-ignored). Every variable Compose or the scripts read.
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow
POSTGRES_DB=mlflow
MLFLOW_PORT=5001
# Host interface for the published ports. Loopback by default; 0.0.0.0 exposes
# the unauthenticated registry / API to the network (deliberate choice only).
MLFLOW_BIND=127.0.0.1
API_BIND=127.0.0.1
# Local volume by default; set to s3://<bucket>/mlflow once ADR-0004's bucket exists.
MLFLOW_ARTIFACTS_DESTINATION=/mlflow/artifacts
# Only needed when MLFLOW_ARTIFACTS_DESTINATION is an S3 URI.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Where `train` logs runs. The Compose server by default.
MLFLOW_TRACKING_URI=http://localhost:5001
# API container
API_PORT=8080
LOG_LEVEL=INFO
GIT_SHA=dev
