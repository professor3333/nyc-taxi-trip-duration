{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid": "DvcRead", "Effect": "Allow", "Action": ["s3:GetObject", "s3:ListBucket"],
     "Resource": ["arn:aws:s3:::S3_BUCKET", "arn:aws:s3:::S3_BUCKET/dvc/*"]},
    {"Sid": "DvcWrite", "Effect": "Allow", "Action": ["s3:PutObject"], "Resource": "arn:aws:s3:::S3_BUCKET/dvc/*"}
  ]
}
