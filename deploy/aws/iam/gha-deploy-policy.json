{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid": "EcrAuth", "Effect": "Allow", "Action": "ecr:GetAuthorizationToken", "Resource": "*"},
    {"Sid": "EcrPush", "Effect": "Allow", "Resource": "arn:aws:ecr:AWS_REGION:ACCOUNT_ID:repository/ECR_REPOSITORY",
     "Action": ["ecr:BatchCheckLayerAvailability", "ecr:CompleteLayerUpload", "ecr:InitiateLayerUpload",
                "ecr:PutImage", "ecr:UploadLayerPart", "ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer", "ecr:DescribeImages"]},
    {"Sid": "LambdaDeploy", "Effect": "Allow", "Resource": "arn:aws:lambda:AWS_REGION:ACCOUNT_ID:function:LAMBDA_FUNCTION_NAME",
     "Action": ["lambda:UpdateFunctionCode", "lambda:GetFunction", "lambda:GetFunctionConfiguration",
                "lambda:InvokeFunction", "lambda:InvokeFunctionUrl", "lambda:GetFunctionUrlConfig"]},
    {"Sid": "DvcReadChampion", "Effect": "Allow", "Action": ["s3:GetObject", "s3:ListBucket"],
     "Resource": ["arn:aws:s3:::S3_BUCKET", "arn:aws:s3:::S3_BUCKET/dvc/*"]},
    {"Sid": "PublishProbeMetrics", "Effect": "Allow", "Action": "cloudwatch:PutMetricData", "Resource": "*", "Condition": {"StringEquals": {"cloudwatch:namespace": "nyc-taxi-trip-duration"}}},
    {"Sid": "ReadColdStartEvidence", "Effect": "Allow", "Action": ["logs:FilterLogEvents", "logs:GetLogEvents"], "Resource": ["arn:aws:logs:AWS_REGION:ACCOUNT_ID:log-group:/aws/lambda/LAMBDA_FUNCTION_NAME", "arn:aws:logs:AWS_REGION:ACCOUNT_ID:log-group:/aws/lambda/LAMBDA_FUNCTION_NAME:*"]}
  ]
}
